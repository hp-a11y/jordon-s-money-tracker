<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Money Tracker: see what you earn, spend and save</title>
<meta name="description" content="A simple money tracker that shows your projected income, spending and savings by day, week, month or year.">
<meta name="theme-color" content="#3b5bdb">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=DM+Sans:wght@400;500;600&display=swap">
<style>
:root{--bg:#eef2f6;--surf:#fff;--text:#14213d;--muted:#5d6b82;--line:#d9e0ea;--accent:#3b5bdb;--good:#0b8f7c;--bad:#d6336c;--warn:#c27803;--sh:0 10px 40px rgba(20,33,61,.12);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d1526;--surf:#16213a;--text:#eaf0fb;--muted:#9aa9c4;--line:#243350;--accent:#7b93ff;--good:#3ddbc0;--bad:#ff6f9f;--warn:#f5b84a;--sh:0 10px 40px rgba(0,0,0,.45);color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0d1526;--surf:#16213a;--text:#eaf0fb;--muted:#9aa9c4;--line:#243350;--accent:#7b93ff;--good:#3ddbc0;--bad:#ff6f9f;--warn:#f5b84a;--sh:0 10px 40px rgba(0,0,0,.45);color-scheme:dark}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 76px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.45 "DM Sans",system-ui,-apple-system,"Segoe UI",sans-serif}
main{max-width:1120px;margin:0 auto;padding:8px 18px 40px}
body::before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(circle,color-mix(in srgb,var(--text) 7%,transparent) 1px,transparent 1.5px) 0 0/24px 24px,radial-gradient(70vmax 55vmax at 5% -8%,color-mix(in srgb,var(--accent) 34%,transparent),transparent 62%),radial-gradient(60vmax 50vmax at 105% 12%,color-mix(in srgb,var(--bad) 22%,transparent),transparent 62%),radial-gradient(70vmax 55vmax at 75% 108%,color-mix(in srgb,var(--good) 28%,transparent),transparent 62%),radial-gradient(50vmax 40vmax at -5% 85%,color-mix(in srgb,var(--warn) 18%,transparent),transparent 62%)}
h2,.amt,.big{font-family:"Bricolage Grotesque","DM Sans",system-ui,sans-serif}
.top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:14px}
.tools{display:flex;gap:10px;align-items:center}
button{font:inherit;cursor:pointer}
.ic{background:var(--surf);border:1px solid var(--line);color:var(--text);border-radius:50%;width:36px;height:36px}
.lead{margin:2px 0 0;color:var(--muted)}
.amt{font-size:clamp(46px,13vw,84px);font-weight:800;letter-spacing:-.03em;line-height:1;font-variant-numeric:tabular-nums;margin:4px 0 8px}
.msg{margin:0 0 14px;font-weight:500}
.good{color:var(--good)}.bad{color:var(--bad)}.warn{color:var(--warn)}
.ro{display:flex;gap:12px;align-items:baseline;flex-wrap:wrap;min-height:26px;font-size:14px;color:var(--muted)}
.ro b{font-family:"Bricolage Grotesque",sans-serif;font-size:20px;color:var(--text)}
#chart{background:var(--surf);border-radius:20px;box-shadow:var(--sh);padding:10px 6px 4px;margin-top:6px}
.chart{width:100%;height:auto;display:block;touch-action:pan-y;cursor:crosshair}
.axis{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);padding:2px 10px 0}
.draw{stroke-dasharray:1;stroke-dashoffset:1;animation:dr 1.2s cubic-bezier(.3,.7,.2,1) forwards}
.fade{opacity:0;animation:fd .9s .5s forwards}
@keyframes dr{to{stroke-dashoffset:0}}@keyframes fd{to{opacity:1}}
.stats{display:grid;grid-template-columns:repeat(2,1fr);margin:26px 0 8px}
.st{padding:10px 14px;border-left:2px solid var(--line)}
.st label,.st .k{display:block;font-size:13px;color:var(--muted)}
.st .big{font-size:24px;font-weight:700;font-variant-numeric:tabular-nums}
.st input{width:100%;font:700 24px "Bricolage Grotesque",sans-serif;color:var(--text);background:transparent;border:0;border-bottom:2px dashed var(--line);padding:0 0 2px;outline:0}
.st input:focus{border-bottom-color:var(--accent)}
@media(min-width:640px){.stats{grid-template-columns:repeat(4,1fr)}}
.blk{background:color-mix(in srgb,var(--surf) 72%,transparent);backdrop-filter:blur(8px);border:1px solid var(--line);border-radius:20px;padding:20px;margin-top:18px}
h2{font-size:20px;margin:0 0 12px;font-weight:700}
input[type=range]{width:100%;accent-color:var(--accent);height:30px}
.br{margin:10px 0}.bt{display:flex;justify-content:space-between;font-size:14px;margin-bottom:5px}
.bb{height:10px;background:var(--line);border-radius:6px;overflow:hidden}.bb i{display:block;height:100%;border-radius:6px;transition:width .6s cubic-bezier(.3,.7,.2,1)}
.it{display:flex;align-items:center;gap:12px;padding:11px 0;border-top:1px solid var(--line)}
.it:first-child{border-top:0}
.em{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;font-size:19px;background:var(--surf);border:1px solid var(--line)}
.it .n{flex:1;min-width:0}.it .n div:first-child{font-weight:600}.it .d{font-size:13px;color:var(--muted)}
.it.past{opacity:.5}
.x{background:none;border:0;color:var(--muted);font-size:20px;padding:4px 8px}
.x:hover{color:var(--bad)}
.empty{color:var(--muted);font-size:15px}
.fab{position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));background:var(--accent);color:#fff;border:0;border-radius:30px;padding:15px 22px;font-weight:700;box-shadow:var(--sh);transition:transform .15s}
.svrow{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 10px}.svrow input{flex:1 1 120px;min-width:0;font:inherit;font-size:16px;color:var(--text);background:var(--surf);border:1px solid var(--line);border-radius:12px;padding:12px}.svb{border:0;border-radius:12px;padding:12px 16px;font-weight:600;background:var(--accent);color:#fff}.svb.o{background:var(--surf);color:var(--text);border:1px solid var(--line)}
.fab:hover{transform:scale(1.05)}.fab:active{transform:scale(.96)}
html::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:40;background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:blur(14px)}
@media(prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:30;background:color-mix(in srgb,var(--bg) 78%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.navin{max-width:1120px;margin:0 auto;padding:10px 18px;display:flex;align-items:center;gap:20px}
.brand{display:flex;align-items:center;gap:10px;font:800 18px "Bricolage Grotesque",system-ui,sans-serif;color:var(--text);text-decoration:none;letter-spacing:-.01em}
.logo{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;font-size:17px;background:linear-gradient(135deg,var(--accent),var(--good))}
.links{display:none;gap:4px;margin-left:12px}.links a{color:var(--muted);text-decoration:none;font-weight:500;padding:7px 12px;border-radius:10px}.links a:hover{color:var(--text);background:var(--surf)}
.nav .tools{margin-left:auto}#sync{font-size:13px;color:var(--muted)}
.navadd{display:none;background:var(--accent);color:#fff;border:0;border-radius:10px;padding:9px 16px;font-weight:700}
.hi{margin:30px 0 0;font-size:15px;color:var(--muted)}
.layout{display:block;max-width:760px;margin:0 auto}
.foot{border-top:1px solid var(--line);color:var(--muted);font-size:14px}.footin{max-width:1120px;margin:0 auto;padding:22px 18px 110px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.foot a{color:var(--accent);text-decoration:none;font-weight:600}
@media(max-width:520px){#sync{display:none}}
@media(min-width:700px){.links{display:flex}.navadd{display:block}.fab{display:none}.footin{padding-bottom:28px}}
@media(min-width:980px){.layout{max-width:none;display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:44px;align-items:start}.hi{margin-top:44px}}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
dialog{border:0;border-radius:22px;padding:22px;width:min(92vw,420px);background:var(--surf);color:var(--text);box-shadow:var(--sh)}
dialog::backdrop{background:rgba(8,12,24,.55);backdrop-filter:blur(3px)}
dialog input,dialog select{width:100%;font:inherit;font-size:16px;color:var(--text);background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px;margin-top:8px}
.seg{display:flex;background:var(--bg);border-radius:12px;padding:4px;margin-bottom:6px}
.seg button{flex:1;background:none;border:0;border-radius:9px;padding:10px;font-weight:600;color:var(--muted)}
.seg button.on{background:var(--surf);color:var(--text);box-shadow:0 2px 8px rgba(0,0,0,.12)}
.seg.per{background:var(--surf);border:1px solid var(--line);margin:26px 0 0}.seg.per+.stats{margin-top:12px}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.cc{background:var(--bg);border:1px solid var(--line);color:var(--text);border-radius:20px;padding:6px 12px;font-size:14px}
.cc.on{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 16%,transparent)}
.acts{display:flex;gap:8px;margin-top:16px}
.acts button{flex:1;padding:13px;border-radius:12px;border:1px solid var(--line);background:none;color:var(--text);font-weight:600}
.acts .go{background:var(--accent);border-color:var(--accent);color:#fff}
#err{color:var(--bad);font-size:14px;min-height:20px;margin-top:8px}
.cf{position:fixed;bottom:80px;right:60px;font-size:24px;pointer-events:none;z-index:60;animation:cf 1.1s ease-out forwards}
@keyframes cf{to{transform:translate(var(--dx),var(--dy)) rotate(50deg);opacity:0}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.draw{stroke-dashoffset:0}.fade{opacity:1}}
</style>
</head>
<body>
<header class="nav"><div class="navin"><a class="brand" href="#overview"><span class="logo">💰</span>Money Tracker</a>
<nav class="links"><a href="#overview">Overview</a><a href="#savings">Savings</a><a href="#spending">Spending</a><a href="#schedule">Schedule</a></nav>
<div class="tools"><span id="sync"></span><button class="ic" id="theme" aria-label="Switch light or dark">◐</button><button class="navadd" id="navadd">+ Add</button></div></div></header>
<main>
<div class="layout"><div class="colL"><section class="hero" id="overview"><p class="hi" id="hi"></p>
<p class="lead">You're on track to finish the week with</p>
<div class="amt" id="end">$0</div>
<p class="msg" id="msg"></p>
<div class="ro" id="ro"></div>
<div id="chart"></div>
<div class="axis"><span id="a0"></span><span id="a1"></span></div></section>

<div class="seg per" id="per"><button data-p="day">Day</button><button data-p="week">Week</button><button data-p="month">Month</button><button data-p="year">Year</button></div>
<section class="stats">
  <div class="st"><label for="bal">Money now</label><input id="bal" type="number" inputmode="decimal" step="0.01" placeholder="0"></div>
  <div class="st"><span class="k" id="k1">Make</span><div class="big good" id="inc"></div></div>
  <div class="st"><span class="k" id="k2">Spend</span><div class="big bad" id="cost"></div></div>
  <div class="st"><span class="k" id="k3">Save</span><div class="big" id="safe"></div></div>
</section>

<section class="blk" id="schedule"><h2>Your schedule</h2><div id="list"></div></section>
</div><div class="colR">
<section class="blk" id="savings"><h2>Saved so far</h2>
  <div class="amt good" id="tot" style="font-size:clamp(40px,11vw,64px)">$0</div>
  <p class="empty" id="svp" style="margin:0 0 10px"></p>
  <div class="svrow"><input id="sva" type="number" inputmode="decimal" step="0.01" min="0" placeholder="Amount" aria-label="Savings amount"><button class="svb" id="svadd">Add to savings</button><button class="svb o" id="svout">Take out</button></div>
  <div id="goalv" style="margin-top:14px"></div>
  <div class="svrow" id="goalf"><input id="gn" placeholder="Savings goal (trip, laptop…)" maxlength="30"><input id="gt" type="number" inputmode="decimal" step="1" min="1" placeholder="Target amount"><button class="svb o" id="gset">Set goal</button></div>
  <div id="svl"></div></section>
<section class="blk"><h2>What if I spend extra?</h2>
  <input type="range" id="wi" min="0" max="500" step="10" value="0" aria-label="Extra spending this week">
  <div class="empty" id="wl">Drag to see how extra spending changes your week.</div></section>
<section class="blk" id="spending"><h2>Where your money goes</h2><div id="cats"></div></section>
</div></div>
</main>
<footer class="foot"><div class="footin"><span>Money Tracker. Your numbers are private to you and sync to your Claude account.</span><a href="#overview">Back to top</a></div></footer>
<button class="fab" id="fab">+ Add</button>

<dialog id="dlg">
  <div class="seg"><button id="tc" class="on">Cost</button><button id="ti">Income</button></div>
  <input id="name" placeholder="Name (rent, paycheque…)" maxlength="40">
  <input id="amt" type="number" inputmode="decimal" step="0.01" min="0" placeholder="Amount">
  <select id="freq"><option value="weekly">Every week</option><option value="biweekly">Every 2 weeks</option><option value="monthly">Every month</option><option value="once">One time</option></select>
  <select id="day"><option value="">Repeats every week on…</option><option value="0">Monday</option><option value="1">Tuesday</option><option value="2">Wednesday</option><option value="3">Thursday</option><option value="4">Friday</option><option value="5">Saturday</option><option value="6">Sunday</option></select>
  <input id="date" type="date" style="display:none" aria-label="Date">
  <div id="dhint" style="display:none;margin-top:6px;font-size:13px;color:var(--muted)"></div>
  <div class="chips" id="chips"></div>
  <div id="err"></div>
  <div class="acts"><button id="cancel">Cancel</button><button class="go" id="save">Save</button></div>
</dialog>

<script>
(function(){
var KEY='money-tracker-v1',state={balance:0,items:[],log:[],goal:null},extra=0,first=true,shown=0,tw=0,dtype='cost',dcat='food';
var CATS={housing:['🏠','Housing','#3b5bdb'],food:['🛒','Food','#f59f00'],bills:['💡','Bills','#12b8c4'],transport:['🚗','Transport','#9c36b5'],fun:['🎉','Fun','#e64980'],other:['✨','Other','#8a97ab'],income:['💼','Income','#0b8f7c']};
var F={day:1/7,week:1,month:52/12,year:52},per='week';try{var pp=localStorage.getItem('mt-per');if(F[pp])per=pp;}catch(e){}
var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
try{var s=localStorage.getItem(KEY);if(s){var p=JSON.parse(s);if(p&&Array.isArray(p.items))state=p;}}catch(e){}
try{var th=localStorage.getItem('mt-theme');if(th)document.documentElement.setAttribute('data-theme',th);}catch(e){}
var FQ={weekly:'weekly',biweekly:'every 2 weeks',monthly:'monthly',once:'one time'};
function pd(s){var p=String(s).split('-');return new Date(+p[0],+p[1]-1,+p[2]);}
function wk(i){return i.freq==='biweekly'?0.5:i.freq==='monthly'?12/52:i.freq==='once'?0:1;}
function occ(i,D){var f=i.freq||'weekly';if(f==='weekly')return i.wd===(D.getDay()+6)%7;var a=pd(i.date);if(f==='once')return a.getFullYear()===D.getFullYear()&&a.getMonth()===D.getMonth()&&a.getDate()===D.getDate();if(f==='biweekly'){var df=Math.round((D-a)/864e5);return((df%14)+14)%14===0;}return D.getDate()===Math.min(a.getDate(),new Date(D.getFullYear(),D.getMonth()+1,0).getDate());}
function norm(){var n=new Date();if(!Array.isArray(state.log))state.log=[];if(state.goal===undefined)state.goal=null;state.items.forEach(function(i){if(typeof i.wd!=='number'){i.wd=(new Date(n.getFullYear(),n.getMonth(),Math.min(i.day||1,28)).getDay()+6)%7;}});}norm();
var cloudRef=null,cloudTimer=null;
function cloudSave(){if(!cloudRef)return;clearTimeout(cloudTimer);cloudTimer=setTimeout(function(){cloudRef.set(JSON.parse(JSON.stringify({balance:state.balance,items:state.items,log:state.log,goal:state.goal||null}))).catch(function(){});},600);}
function save(){try{localStorage.setItem(KEY,JSON.stringify(state));}catch(e){}cloudSave();}
var f0=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD',maximumFractionDigits:0}),f2=new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD'});
function $(id){return document.getElementById(id);}
function esc(t){return String(t).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function tween(el,to){var from=shown,id=++tw;shown=to;if(reduce||from===to){el.textContent=f0.format(to);return;}var t0=performance.now();(function step(t){if(id!==tw)return;var k=Math.min(1,(t-t0)/700),e=1-Math.pow(1-k,3);el.textContent=f0.format(from+(to-from)*e);if(k<1)requestAnimationFrame(step);})(t0);}

function render(){
  var now=new Date(),left=7,twd=(now.getDay()+6)%7;function lab(k){return new Date(now.getFullYear(),now.getMonth(),now.getDate()+k).toLocaleDateString('en-CA',{weekday:'short',day:'numeric'});}
  var h=now.getHours();
  $('hi').textContent=(h<12?'Good morning':h<18?'Good afternoon':'Good evening')+', it\'s '+lab(0);
  if(document.activeElement!==$('bal'))$('bal').value=state.balance||'';
  var inc=0,cost=0,bycat={};
  state.items.forEach(function(i){var a=i.amount*wk(i);if(i.type==='income')inc+=a;else{cost+=a;var c=CATS[i.cat]&&i.cat!=='income'?i.cat:'other';bycat[c]=(bycat[c]||0)+a;}});
  var bal=state.balance,rows=[],low=bal,lowDay=0;
  for(var k=0;k<7;k++){
    var D=new Date(now.getFullYear(),now.getMonth(),now.getDate()+k),ev=state.items.filter(function(i){return occ(i,D);});
    ev.forEach(function(i){bal+=i.type==='income'?i.amount:-i.amount;});
    var adj=bal-extra*(k+1)/left;
    rows.push({ev:ev,bal:adj});if(adj<low){low=adj;lowDay=k;}
  }
  var end=rows[rows.length-1].bal;
  tween($('end'),end);$('end').className='amt'+(end<0?' bad':'');
  var fx=F[per],u={day:'day',week:'week',month:'month',year:'year'}[per];$('inc').textContent=f0.format(inc*fx);$('cost').textContent=f0.format(cost*fx);$('k1').textContent='Make per '+u;$('k2').textContent='Spend per '+u;$('k3').textContent=per==='year'?'Save per year + money now':'Save per '+u;Array.prototype.forEach.call($('per').children,function(b){b.className=b.getAttribute('data-p')===per?'on':'';});
  var save=inc-cost-extra;var sv=save*fx+(per==='year'?state.balance:0);$('safe').textContent=f0.format(sv);$('safe').className='big '+(sv<0?'bad':'good');
  var msg=$('msg');
  if(!state.items.length&&!state.balance){msg.className='msg';msg.textContent='Add what you have and what you earn and owe to see your month.';}
  else if(low<0){msg.className='msg bad';msg.textContent='Heads up: you could dip to '+f0.format(low)+' around '+lab(lowDay)+'.';}
  else if(save<0){msg.className='msg warn';msg.textContent='You are spending '+f0.format(-save)+' more than you earn this week.';}
  else if(inc>0&&save<inc*0.1){msg.className='msg warn';msg.textContent='Tight but doable. You would save only '+f0.format(save)+' this week.';}
  else{msg.className='msg good';msg.textContent='Looking good. You can save about '+f0.format(save)+' this week.';}
  $('wl').textContent=extra?'Spending '+f0.format(extra)+' extra leaves you with '+f0.format(end)+' at the end of the week.':'Drag to see how extra spending changes your week.';
  $('a0').textContent=lab(0);$('a1').textContent=lab(6);

  var W=600,H=220,pad=16,n=rows.length,vals=rows.map(function(r){return r.bal;}),mn=Math.min.apply(null,vals.concat(0)),mx=Math.max.apply(null,vals.concat(0));
  if(mx===mn)mx=mn+1;
  function X(i){return n>1?pad+i/(n-1)*(W-2*pad):W/2;}
  function Y(v){return pad+(mx-v)/(mx-mn)*(H-2*pad);}
  var pts=rows.map(function(r,i){return(i?'L':'M')+X(i)+' '+Y(r.bal);}).join(' ');
  var area=pts+' L'+X(n-1)+' '+Y(mn)+' L'+X(0)+' '+Y(mn)+' Z';
  var dots=rows.map(function(r,i){return r.ev.length?'<circle cx="'+X(i)+'" cy="'+Y(r.bal)+'" r="4.5" style="fill:'+(r.ev.some(function(q){return q.type==='income';})?'var(--good)':'var(--bad)')+'"/>':'';}).join('');
  $('chart').innerHTML='<svg class="chart" viewBox="0 0 '+W+' '+H+'" role="img" aria-label="Projected balance. Move across it to see each day.">'+
   '<defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" style="stop-color:var(--accent);stop-opacity:.35"/><stop offset="1" style="stop-color:var(--accent);stop-opacity:0"/></linearGradient></defs>'+
   '<line x1="0" x2="'+W+'" y1="'+Y(0)+'" y2="'+Y(0)+'" style="stroke:var(--line)" stroke-dasharray="4 5"/>'+
   '<path d="'+area+'" fill="url(#g)" class="'+(first?'fade':'')+'"/>'+
   '<path d="'+pts+'" pathLength="1" fill="none" style="stroke:var(--accent)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="'+(first?'draw':'')+'"/>'+dots+
   '<line id="vl" y1="0" y2="'+H+'" style="stroke:var(--accent);opacity:0" stroke-width="1.5"/><circle id="dt" r="7" style="fill:var(--surf);stroke:var(--accent);opacity:0" stroke-width="3"/></svg>';
  first=false;
  var svg=$('chart').firstChild,vl=svg.querySelector('#vl'),dt=svg.querySelector('#dt');
  function show(i,on){var r=rows[i];vl.setAttribute('x1',X(i));vl.setAttribute('x2',X(i));dt.setAttribute('cx',X(i));dt.setAttribute('cy',Y(r.bal));vl.style.opacity=dt.style.opacity=on?1:0;
    $('ro').innerHTML='<span>'+lab(i)+'</span><b class="'+(r.bal<0?'bad':'')+'">'+f2.format(r.bal)+'</b><span>'+(r.ev.length?r.ev.map(function(q){return esc(q.name)+' '+(q.type==='income'?'+':'−')+f0.format(q.amount);}).join(', '):(on?'Nothing scheduled':'Move across the chart to explore each day'))+'</span>';}
  function mv(e){var b=svg.getBoundingClientRect();show(Math.max(0,Math.min(n-1,Math.round((e.clientX-b.left)/b.width*(n-1)))),true);}
  svg.addEventListener('pointermove',mv);svg.addEventListener('pointerdown',mv);svg.addEventListener('pointerleave',function(){show(n-1,false);});
  show(n-1,false);

  var tot=state.log.reduce(function(a,l){return a+l.amt;},0);$('tot').textContent=f2.format(tot);$('tot').className='amt '+(tot<0?'bad':'good');
  $('svp').textContent=save>0?'At this pace you will have '+f0.format(tot+save*52)+' saved in a year.':'';
  $('svl').innerHTML=state.log.length?state.log.slice(-5).reverse().map(function(l){return '<div class="it"><div class="em">'+(l.amt<0?'📤':'💰')+'</div><div class="n"><div>'+(l.amt<0?'Taken out':'Added to savings')+'</div><div class="d">'+new Date(l.ts).toLocaleDateString('en-CA',{month:'short',day:'numeric'})+'</div></div><b class="'+(l.amt<0?'bad':'good')+'">'+(l.amt<0?'−':'+')+f2.format(Math.abs(l.amt))+'</b><button class="x" data-l="'+l.id+'" aria-label="Delete entry">×</button></div>';}).join(''):'<div class="empty">Nothing saved yet. Enter an amount and tap Add to savings.</div>';
  var g=state.goal;$('goalf').style.display=g?'none':'flex';
  if(g){var pc=Math.max(0,Math.min(100,tot/g.target*100)),rem=g.target-tot,eta='';
    if(rem<=0)eta='Goal reached. Nice work! 🎉';
    else if(save>0){var wks=Math.ceil(rem/save);eta='About '+wks+' week'+(wks===1?'':'s')+' to go at your current pace ('+new Date(now.getFullYear(),now.getMonth(),now.getDate()+wks*7).toLocaleDateString('en-CA',{month:'short',day:'numeric',year:'numeric'})+').';}
    else eta='Your weekly savings are at zero or below. Add income or trim costs to reach it.';
    $('goalv').innerHTML='<div class="br"><div class="bt"><span>🎯 '+esc(g.name)+'</span><span>'+f0.format(Math.max(0,tot))+' of '+f0.format(g.target)+'</span></div><div class="bb"><i style="width:'+pc+'%;background:var(--good)"></i></div></div><div class="empty">'+eta+'</div><button class="x" id="grm" style="padding-left:0;font-size:14px">Remove goal</button>';
  }else $('goalv').innerHTML='';
  var keys=Object.keys(bycat).sort(function(a,b){return bycat[b]-bycat[a];}),top=keys.length?bycat[keys[0]]:1;
  $('cats').innerHTML=keys.length?keys.map(function(c){var v=CATS[c];return '<div class="br"><div class="bt"><span>'+v[0]+' '+v[1]+'</span><span>'+f0.format(bycat[c]*F[per])+' ('+Math.round(bycat[c]/cost*100)+'%)</span></div><div class="bb"><i style="width:'+bycat[c]/top*100+'%;background:'+v[2]+'"></i></div></div>';}).join(''):'<div class="empty">Add a cost and you will see where your money goes.</div>';

  function dd(i){for(var k=0;k<400;k++){if(occ(i,new Date(now.getFullYear(),now.getMonth(),now.getDate()+k)))return k;}return 999;}var its=state.items.slice().sort(function(a,b){return dd(a)-dd(b);});
  $('list').innerHTML=its.length?its.map(function(i){
    var diff=dd(i),past=diff===999,v=CATS[i.cat]||CATS[i.type==='income'?'income':'other'];
    return '<div class="it'+(past?' past':'')+'"><div class="em">'+v[0]+'</div><div class="n"><div>'+esc(i.name)+'</div><div class="d">'+(past?'Already happened':lab(diff)+', '+(diff===0?'today':diff===1?'tomorrow':'in '+diff+' days'))+' ('+FQ[i.freq||'weekly']+')'+'</div></div>'+
      '<b class="'+(i.type==='income'?'good':'bad')+'">'+(i.type==='income'?'+':'−')+f2.format(i.amount)+'</b><button class="x" data-id="'+i.id+'" aria-label="Delete '+esc(i.name)+'">×</button></div>';
  }).join(''):'<div class="empty">Nothing here yet. Tap Add to enter your first paycheque or bill.</div>';
}

function pop(){if(reduce)return;for(var i=0;i<16;i++){var s=document.createElement('span');s.className='cf';s.textContent=['💸','✨','🎉','💰'][i%4];s.style.setProperty('--dx',(Math.random()*280-220)+'px');s.style.setProperty('--dy',(-100-Math.random()*220)+'px');document.body.appendChild(s);setTimeout(function(el){el.remove();}.bind(null,s),1200);}}
function setType(t){dtype=t;$('tc').className=t==='cost'?'on':'';$('ti').className=t==='income'?'on':'';$('chips').style.display=t==='cost'?'flex':'none';}
function drawChips(){$('chips').innerHTML=Object.keys(CATS).filter(function(c){return c!=='income';}).map(function(c){return '<button class="cc'+(c===dcat?' on':'')+'" data-c="'+c+'">'+CATS[c][0]+' '+CATS[c][1]+'</button>';}).join('');}
function add(){
  var name=$('name').value.trim(),amt=parseFloat($('amt').value),day=parseInt($('day').value,10);
  if(!name||!(amt>=0)||(($('freq').value==='weekly')?!(day>=0&&day<=6):!$('date').value)){$('err').textContent=$('freq').value==='weekly'?'Enter a name, an amount, and pick a day of the week.':'Enter a name, an amount, and pick a date.';return;}
  state.items.push({id:Date.now()+Math.random().toString(36).slice(2,6),type:dtype,name:name,amount:amt,freq:$('freq').value,wd:day>=0?day:0,date:$('date').value,cat:dtype==='income'?'income':dcat});
  $('name').value=$('amt').value=$('day').value=$('date').value='';$('err').textContent='';
  $('dlg').close();save();render();if(dtype==='income')pop();
}
$('bal').addEventListener('input',function(){state.balance=parseFloat(this.value)||0;save();render();});
$('wi').addEventListener('input',function(){extra=+this.value;render();});
$('fab').addEventListener('click',function(){$('dlg').showModal();$('name').focus();});
$('navadd').addEventListener('click',function(){$('dlg').showModal();$('name').focus();});
$('cancel').addEventListener('click',function(){$('dlg').close();});
$('dlg').addEventListener('click',function(e){if(e.target===this)this.close();});
$('save').addEventListener('click',add);
$('tc').addEventListener('click',function(){setType('cost');});$('ti').addEventListener('click',function(){setType('income');});
['name','amt','day'].forEach(function(id){$(id).addEventListener('keydown',function(e){if(e.key==='Enter')add();});});
$('chips').addEventListener('click',function(e){var c=e.target.getAttribute('data-c');if(c){dcat=c;drawChips();}});
document.body.addEventListener('click',function(e){var id=e.target.getAttribute&&e.target.getAttribute('data-id');if(id){state.items=state.items.filter(function(i){return String(i.id)!==id;});save();render();}});
$('theme').addEventListener('click',function(){var r=document.documentElement,dark=r.getAttribute('data-theme')?r.getAttribute('data-theme')==='dark':matchMedia('(prefers-color-scheme: dark)').matches,t=dark?'light':'dark';r.setAttribute('data-theme',t);try{localStorage.setItem('mt-theme',t);}catch(e){}});
$('per').addEventListener('click',function(e){var p=e.target.getAttribute('data-p');if(p){per=p;try{localStorage.setItem('mt-per',p);}catch(x){}render();}});
function svAdd(sign){var v=parseFloat($('sva').value);if(!(v>0))return;state.log.push({id:Date.now()+Math.random().toString(36).slice(2,6),amt:sign*v,ts:Date.now()});$('sva').value='';save();render();if(sign>0)pop();}
$('svadd').addEventListener('click',function(){svAdd(1);});$('svout').addEventListener('click',function(){svAdd(-1);});
$('sva').addEventListener('keydown',function(e){if(e.key==='Enter')svAdd(1);});
$('svl').addEventListener('click',function(e){var id=e.target.getAttribute('data-l');if(id){state.log=state.log.filter(function(l){return String(l.id)!==id;});save();render();}});
function fz(){var f=$('freq').value,w=f==='weekly';$('day').style.display=w?'':'none';$('date').style.display=w?'none':'';$('dhint').style.display=w?'none':'';$('dhint').textContent={biweekly:'Pick the next date. It repeats every 14 days.',monthly:'Pick the next date. It repeats on the same day each month.',once:'Pick the date it happens. One-time items show in your balance chart but not in the weekly totals.'}[f]||'';}
$('freq').addEventListener('change',fz);
$('gset').addEventListener('click',function(){var n=$('gn').value.trim(),t=parseFloat($('gt').value);if(!n||!(t>0))return;state.goal={name:n,target:t};$('gn').value=$('gt').value='';save();render();});
$('goalv').addEventListener('click',function(e){if(e.target.id==='grm'){state.goal=null;save();render();}});
drawChips();render();
(async function(){
  try{
    if(!window.claude||!window.claude.use)return;
    var db=await window.claude.use('db'),user=await window.claude.use('user');
    if(!db||!user)return;
    var uid=await user.id();
    if(!uid)return;
    var ref=db.doc('data/users/'+uid+'/main'),snap=await ref.get();
    if(snap.exists){
      var d=snap.data();
      if(d&&Array.isArray(d.items)){
        state={balance:Number(d.balance)||0,goal:d.goal||null,log:Array.isArray(d.log)?d.log.map(function(l){return{id:l.id,amt:l.amt,ts:l.ts};}):[],items:d.items.map(function(i){return{id:i.id,type:i.type,name:i.name,amount:i.amount,day:i.day,cat:i.cat,wd:i.wd,day:i.day,freq:i.freq,date:i.date};})};norm();
        try{localStorage.setItem(KEY,JSON.stringify(state));}catch(e){}
        render();
      }
    }else if(state.items.length||state.balance){
      await ref.set(JSON.parse(JSON.stringify({balance:state.balance,items:state.items,log:state.log,goal:state.goal||null})));
    }
    cloudRef=ref;
    $('sync').textContent='Synced to your account';
  }catch(e){}
})();
})();
</script>
</body>
</html>
